{
  "name": "server",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "NODE_ENV=development bun run --hot src/index.ts",
    "build": "NODE_ENV=production bun build src/index.ts --outdir dist --target bun",
    "start": "NODE_ENV=production bunx prisma db push && bun run dist/index.js",
    "studio": "prisma studio --port 3001 --hostname 0.0.0.0",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/papaparse": "^5.5.2",
    "prisma": "^6.17.1"
  },
  "peerDependencies": {
    "typescript": "5.8.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.86.1",
    "@better-auth/expo": "1.3.24",
    "@hono/node-server": "1.12.0",
    "@hono/zod-validator": "0.7.3",
    "@prisma/client": "^6.17.1",
    "@supabase/supabase-js": "^2.90.1",
    "@vibecodeapp/backend-sdk": "^1.0.1",
    "@vibecodeapp/cloud-studio": "^0.2.4",
    "@vibecodeapp/proxy": "^2.0.3",
    "better-auth": "1.3.24",
    "hono": "^4.13.11",
    "openai": "^6.45.0",
    "papaparse": "^5.5.3",
    "youtube-transcript": "^1.3.1",
    "zod": "4.1.11"
  }
}
